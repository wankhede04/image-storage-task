# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://aragon:aragon@localhost:5433/aragon_db

# Redis
REDIS_URL=redis://localhost:6379

# --- Object Storage ---
# Local dev uses MinIO (S3-compatible, no AWS account needed).
# To switch to real AWS S3: unset S3_ENDPOINT + S3_FORCE_PATH_STYLE, set real creds below.

# MinIO (local dev defaults)
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=aragon-images

# Real AWS S3 (comment out the MinIO vars above, then fill these in)
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=<real-access-key>
# AWS_SECRET_ACCESS_KEY=<real-secret-key>
# S3_BUCKET=<your-bucket-name>
# S3_SSE=AES256  # optional: server-side encryption

# CORS
CORS_ORIGIN=http://localhost:5173

# Validation thresholds (configurable)
BLUR_THRESHOLD=100
MIN_IMAGE_WIDTH=500
MIN_IMAGE_HEIGHT=500
MIN_FILE_SIZE_BYTES=50000
SIMILARITY_HAMMING_THRESHOLD=10
FACE_AREA_MIN_RATIO=0.02

# --- Processing pipeline (Part 2) ---
WORKER_CONCURRENCY=4
COMPRESSION_QUALITY=80
THUMBNAIL_SIZE=256
WEB_SIZE=1280
# LOAD_TEST_MODE skips face + similarity validation so a load test can push
# many unique synthetic images through the pipeline. NEVER enable in production.
LOAD_TEST_MODE=false

# Client
VITE_API_URL=http://localhost:3001
